{
  "manifest_version": 3,
  "name": "AI Auto-Sender",
  "version": "5.0.0",
  "description": "Schedule prompts to Claude, ChatGPT, and Gemini with multi-queue, multi-tab, dry-run, and recurring schedules.",
  "minimum_chrome_version": "120",
  "permissions": ["alarms", "storage", "tabs", "windows", "scripting", "notifications"],
  "host_permissions": [
    "https://*.claude.ai/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*"
  ],
  "background": { "service_worker": "src/background/index.js", "type": "module" },
  "action": { "default_popup": "src/popup/popup.html" },
  "options_ui": { "page": "src/options/options.html", "open_in_tab": true },
  "content_scripts": [
    {
      "matches": [
        "https://*.claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*"
      ],
      "js": ["src/content/index.js"]
    }
  ],
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}