{
  "manifest_version": 3,
  "name": "AI Auto-Sender",
  "version": "5.1.0",
  "description": "Schedule prompts to any AI chat site (Claude, ChatGPT, Gemini, and beyond) with multi-queue, multi-tab, dry-run, and recurring schedules.",
  "minimum_chrome_version": "120",
  "permissions": ["alarms", "storage", "tabs", "windows", "scripting"],
  "host_permissions": ["<all_urls>"],
  "content_security_policy": {
    "extension_pages": "default-src 'self'"
  },
  "background": { "service_worker": "dist/background.js", "type": "module" },
  "action": { "default_popup": "dist/popup.html" },
  "options_ui": { "page": "dist/options.html", "open_in_tab": true },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"]
    }
  ],
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}